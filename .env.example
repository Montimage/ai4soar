# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
SERVER_DEBUG=false

# MongoDB
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=ai4soar

# NATS messaging broker
NATS_HOST=localhost
NATS_PORT=4222

# Kafka messaging broker
KAFKA_BROKERS=localhost:9093
KAFKA_SSL_PASSWORD=

# LLM provider
# LLM (anthropic) — active
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# LLM (openai)
# LLM_PROVIDER=openai
LLM_MODEL=gpt-5
OPENAI_API_KEY=

# LLM (ollama)
# LLM_PROVIDER=ollama
# OLLAMA_HOST=localhost
# OLLAMA_PORT=11434
# OLLAMA_MODEL=qwen3.6:35b
# LLM_TIMEOUT=180

# Path B — LLM MITRE technique attribution
LLM_CONFIDENCE_THRESHOLD=0.70

# LLM_ATTRIBUTION_VOCAB=all        # all (697 techniques, as benchmarked) | parents (222)
# LLM_ATTRIBUTION_TOP_K=5          # how many ranked techniques the model is ASKED for.
#                                  # 5 is the benchmarked prompt; any other value changes
#                                  # the prompt bytes and invalidates the eval cache.
# LLM_ATTRIBUTION_RANKED_K=5       # ranked ids consulted for playbooks; defaults to TOP_K
# LLM_REASONING_EFFORT=medium      # gpt-5* / o-series only: minimal | medium | high

# The next two are auto-raised (to 16384 / 32768) for reasoning-capable local models
# LLM_ATTRIBUTION_MAX_TOKENS=512   # output budget for the ranked answer
# LLM_NUM_CTX=16384                # Ollama context window; MUST fit the ~9.3K prompt

# ML model (options: knn | lr | ovr_lr | ovr_svm | rf | mlp)
SIMILARITY_MODEL=mlp

# Orchestration tuning (optional — defaults shown)
# ORCH_PATH_C_ENABLED=true
# ORCH_EARLY_EXIT_THRESHOLD=0.85   # Path A confidence that exits at Stage 1 / HIGH tier
# ORCH_LOW_CONF_THRESHOLD=0.50     # below this, Stage 2 falls through to Path D
# ORCH_PATH_C_DISCOUNT=0.85        # applied when Path C answers alone
# ORCH_CONFIRMATION_BONUS=0.10     # added when Path B and Path C agree

# Playbook library
# PLAYBOOK_LIBRARY_PATH=playbooks
