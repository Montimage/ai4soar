# AI4SOAR settings. Copy to .env and fill in the two required values; everything else
# has working defaults. Full reference: docs/CONFIGURATION.md

# ── Required ─────────────────────────────────────────────────────────────────────────
# Shuffle API key (Shuffle → Settings → API key)
SHUFFLE_API_TOKEN=
# LLM for Path B (technique attribution), Path D (playbook generation), LLM review.
# Other providers (openai, ollama): docs/CONFIGURATION.md
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Services (defaults fit a local install; docker-compose.local.yml sets its own) ───
SHUFFLE_API_BASE_URL=http://localhost:5001/api/v1
SHUFFLE_UI_URL=http://localhost:3001
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=ai4soar
NATS_HOST=localhost
NATS_PORT=4222
KAFKA_BROKERS=
KAFKA_TOPIC=ai4soar.alerts

# ── Playbook integrations (optional; docs/CONFIGURATION.md) ─────────────────────────
# Ticketing system and mail gateway the playbooks' API steps call
# INCIDENT_API_URL=https://tickets.example.org
# MAIL_API_URL=https://mail-gateway.example.org
# Reputation playbook: VirusTotal key, and the firewall host it blocks malicious IPs on
# (a dedicated account allowed to run sudo iptables)
# VIRUSTOTAL_API_KEY=
# FIREWALL_SSH_HOST=
# FIREWALL_SSH_PORT=22
# FIREWALL_SSH_USER=
# FIREWALL_SSH_PASSWORD=
# SOARCA (docker-compose.soarca.yml): dry runs of the playbooks before running them
# SOARCA_URL=http://host.docker.internal:8082
# SOARCA_SANDBOX_PASSWORD=

# Hackathon / demo setup (demo victim, AI4SOAR as ticketing API):
# docs/hackathon/.env.hackathon.example
