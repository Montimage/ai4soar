# Hackathon / demo settings, ON TOP OF .env (docs/INSTALL.md, step 4). The playbooks then act on
# the demo victim web-01, not on the hosts the alerts name.
#
#   sed "/^#/! s/CHANGE_ME/$(openssl rand -hex 16)/" docs/hackathon/.env.hackathon.example >> .env
#
# then set VIRUSTOTAL_API_KEY in .env. The placeholder passwords below become one random
# password for the lab containers (the SOARCA sandbox doubles as the reputation
# playbook's firewall).
# Docker Desktop (macOS, Windows): host.docker.internal instead of 172.17.0.1 below, and
# LAB_HOST_IP=127.0.0.1.

# SOARCA dry runs (docker-compose.soarca.yml)
SOARCA_URL=http://host.docker.internal:8082
SOARCA_SANDBOX_PASSWORD=CHANGE_ME

# Demo victim web-01 (docker-compose.lab.yml)
DEMO_VICTIM_HOST=172.17.0.1
DEMO_VICTIM_PORT=2224
DEMO_VICTIM_USER=root
DEMO_VICTIM_PASSWORD=CHANGE_ME

# AI4SOAR as the playbooks' ticketing and mail API: tickets pop up in the UI.
INCIDENT_API_URL=http://172.17.0.1.nip.io:5000
MAIL_API_URL=http://172.17.0.1.nip.io:5000

# Reputation playbook: blocks malicious IPs on the SOARCA sandbox
FIREWALL_SSH_HOST=172.17.0.1
FIREWALL_SSH_PORT=2223
FIREWALL_SSH_USER=ai4soar
FIREWALL_SSH_PASSWORD=CHANGE_ME
VIRUSTOTAL_API_KEY=
